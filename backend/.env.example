SECRET_KEY=replace-with-a-long-random-string
DATABASE_URL=sqlite:///./nivora.db
FRONTEND_ORIGINS=http://localhost:5173
FRONTEND_URL=http://localhost:5173
# Forgot password email (optional). Gmail: use an App Password, host smtp.gmail.com, port 587.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# --- OTP at sign-up (email is sent through the SMTP settings above) ---
OTP_REQUIRED=true
# Optional SMS through Twilio (trial accounts only text numbers you verified in Twilio)
TWILIO_SID=
TWILIO_TOKEN=
TWILIO_FROM=

# --- AI assistant. Get a key at console.anthropic.com. Leave empty to use the rule-based assistant. ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
LLM_WEB_SEARCH=true